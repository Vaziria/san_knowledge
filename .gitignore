# Build output (rebuild with golang/packages/san_knowledge/build.sh or build.ps1)
bin/knowledge
bin/*.exe
bin/*.exe~
# Knowledge UI: built into the binary from golang/packages/san_knowledge/ui by the build scripts
golang/packages/san_knowledge/ui/node_modules/
golang/packages/san_knowledge/internal/ownview/dist/*
!golang/packages/san_knowledge/internal/ownview/dist/.gitkeep

# Live graph database: binary bbolt file, rewritten on every change.
# Version knowledge through JSON exports instead: bin/knowledge.exe export knowledge_data/export.json
**/knowledge_data/*.db
**/knowledge_data/*.db.lock

# graphify's code graph: rebuilt from the code with `graphify update .`
graphify-out/

# Chrome profiles of the san_* tools (golang/packages/san_profile_manager):
# signed-in sessions, never committed
browser_profiles/*
!browser_profiles/.gitkeep

# Personal Claude Code settings
.claude/settings.local.json

# Go
*.test
*.out

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
*.exe.stackdump
shared_data
sandbox/