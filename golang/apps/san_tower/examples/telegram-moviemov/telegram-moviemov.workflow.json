  "workflows": [
    {
      "name": "Telegram MovieMov",
      "steps": [
        {
          "id": "cmd",
          "kind": "telegram-command",
          "y": 520,
          "values": {
            "Commands": "[{\"Command\": \"start\", \"Description\": \"Menu MovieMov\"}, {\"Command\": \"upload\", \"Description\": \"Upload film baru\"}, {\"Command\": \"laporan\", \"Description\": \"Cek laporan film rusak\"}, {\"Command\": \"hapus\", \"Description\": \"Hapus film\"}]",
            "Connection": "1"
          }
        },
        {
          "id": "menu",
          "kind": "telegram-menu",
          "x": 320,
          "values": {
            "Buttons": "[{\"Button\": \"Upload film\", \"Command\": \"upload\"}, {\"Button\": \"Cek laporan\", \"Command\": \"laporan\"}, {\"Button\": \"Hapus film\", \"Command\": \"hapus\"}]",
            "Connection": "1",
            "Per Row": "2",
            "Text": "MovieMov: mau ngapain?"
          }
        },
        {
          "id": "upload_form",
          "kind": "telegram-form",
          "x": 320,
          "y": 440,
          "values": {
            "Connection": "1",
            "Questions": "[{\"Name\": \"judul\", \"Question\": \"Judul filmnya apa?\", \"Type\": \"Text\", \"Required\": \"Yes\", \"Max\": \"255\", \"Field\": \"title, slug\"}, {\"Name\": \"link\", \"Question\": \"Link film (https) atau kode iframe-nya?\", \"Type\": \"Link or Iframe\", \"Required\": \"Yes\", \"Starts With\": \"https://\", \"Field\": \"embed_url\"}, {\"Name\": \"kategori\", \"Question\": \"Kategorinya?\", \"Type\": \"Multiple Choice\", \"Required\": \"No\", \"Choices\": \"Action, Drama, Horor, Komedi, Thriller, Sci-Fi\", \"Max\": \"10\", \"Field\": \"categories\"}, {\"Name\": \"tag\", \"Question\": \"Tag-nya?\", \"Type\": \"List\", \"Required\": \"No\", \"Max\": \"20\", \"Field\": \"tags\"}, {\"Name\": \"thumbnail\", \"Question\": \"Kirim thumbnail-nya (Lewati: pakai thumbnail dari Vidara)\", \"Type\": \"Photo\", \"Required\": \"No\", \"Max\": \"2\", \"Field\": \"thumbnail\"}, {\"Name\": \"status\", \"Question\": \"Statusnya?\", \"Type\": \"Choice\", \"Required\": \"Yes\", \"Choices\": \"Draft, Published\", \"Default\": \"Draft\", \"Field\": \"status\"}]",
            "Timeout": "10m",
            "Tries": "3"
          }
        },
        {
          "id": "upload_thumb",
          "kind": "vidara-thumbnail",
          "x": 640,
          "y": 440,
          "values": {
            "Mode": "Download"
          }
        },
        {
          "id": "upload",
          "kind": "moviemov-upload",
          "x": 960,
          "y": 440,
          "values": {
            "Connection": "2",
            "Status": "From Input"
          }
        },
        {
          "id": "uploaded_text",
          "kind": "format-text",
          "x": 1280,
          "y": 440,
          "values": {
            "Format": "Sudah diupload: {{ text }}"
          }
        },
        {
          "id": "uploaded_send",
          "kind": "telegram-send",
          "x": 1600,
          "y": 440,
          "values": {
            "Connection": "1",
            "Format": "Plain",
            "Long Text": "Split",
            "Media": "None"
          }
        },
        {
          "id": "upload_failed_text",
          "kind": "format-text",
          "x": 1280,
          "y": 940,
          "values": {
            "Format": "Gagal upload: {{ text }}"
          }
        },
        {
          "id": "upload_failed_send",
          "kind": "telegram-send",
          "x": 1600,
          "y": 940,
          "values": {
            "Connection": "1",
            "Format": "Plain",
            "Long Text": "Split",
            "Media": "None"
          }
        },
        {
          "id": "thumb_failed_text",
          "kind": "format-text",
          "x": 1280,
          "y": 1440,
          "values": {
            "Format": "Gagal ambil thumbnail dari Vidara: {{ text }}. Coba /upload lagi dan kirim fotonya."
          }
        },
        {
          "id": "thumb_failed_send",
          "kind": "telegram-send",
          "x": 1600,
          "y": 1440,
          "values": {
            "Connection": "1",
            "Format": "Plain",
            "Long Text": "Split",
            "Media": "None"
          }
        },
        {
          "id": "reports",
          "kind": "moviemov-reports",
          "x": 320,
          "y": 1460,
          "values": {
            "Connection": "2"
          }
        },
        {
          "id": "report_line",
          "kind": "template",
          "x": 640,
          "y": 1460,
          "values": {
            "Text": "• {{ payload.movie.title }} ({{ payload.movie.slug }}): {{ payload.open_reports }} laporan"
          }
        },
        {
          "id": "report_send",
          "kind": "telegram-send",
          "x": 960,
          "y": 1460,
          "values": {
            "Connection": "1",
            "Format": "Plain",
            "Long Text": "Split",
            "Media": "None"
          }
        },
        {
          "id": "reports_count",
          "kind": "format-text",
          "x": 640,
          "y": 1960,
          "values": {
            "Format": "{{ text }} film dilaporkan rusak."
          }
        },
        {
          "id": "reports_send",
          "kind": "telegram-send",
          "x": 960,
          "y": 1960,
          "values": {
            "Connection": "1",
            "Format": "Plain",
            "Long Text": "Split",
            "Media": "None"
          }
        },
        {
          "id": "delete_form",
          "kind": "telegram-form",
          "x": 320,
          "y": 2480,
          "values": {
            "Connection": "1",
            "Questions": "[{\"Name\": \"slug\", \"Question\": \"Slug filmnya? (contoh: night-train)\", \"Type\": \"Text\", \"Required\": \"Yes\", \"Field\": \"slug\"}, {\"Name\": \"yakin\", \"Question\": \"Yakin hapus film ini?\", \"Type\": \"Yes/No\", \"Required\": \"Yes\"}]",
            "Timeout": "10m",
            "Tries": "3"
          }
        },
        {
          "id": "sure",
          "kind": "prefix-filter",
          "x": 640,
          "y": 2480,
          "values": {
            "Prefix": "Yes"
          }
        },
        {
          "id": "delete",
          "kind": "moviemov-delete",
          "x": 960,
          "y": 2480,
          "values": {
            "Connection": "2"
          }
        },
        {
          "id": "deleted_text",
          "kind": "format-text",
          "x": 1280,
          "y": 2480,
          "values": {
            "Format": "Sudah dihapus: {{ text }}"
          }
        },
        {
          "id": "deleted_send",
          "kind": "telegram-send",
          "x": 1600,
          "y": 2480,
          "values": {
            "Connection": "1",
            "Format": "Plain",
            "Long Text": "Split",
            "Media": "None"
          }
        },
        {
          "id": "missing_text",
          "kind": "format-text",
          "x": 1280,
          "y": 2980,
          "values": {
            "Format": "Film tidak ditemukan: {{ text }}"
          }
        },
        {
          "id": "missing_send",
