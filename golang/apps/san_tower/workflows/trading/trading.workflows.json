  "workflows": [
    {
      "name": "trade open",
      "description": "Opens a position, or places a limit entry that waits, on the Binance test network, for the trade tick. Run with a JSON object: {\"symbol\": \"BTCUSDT\", \"side\": \"buy\" or \"sell\", \"type\": \"limit\" or \"market\", \"quantity\": 0.012 (in the coin), \"price\": 80000 (a limit's), \"stop_loss\": 79500, \"take_profit\": 81200, \"expires_min\": 15 (a limit's, 15 by default), \"approaches\": \"big_trend,positioning\", \"reason\": \"thesis: ...; trigger: ...; invalid if: ...; target: ...\"}. Pairs: BTCUSDT, ETHUSDT, BNBUSDT, BCHUSDT. Refused, with the reason: no stop loss, over 1000 USDT of notional or 100 USDT lost at the stop (the most that fits is said), a pair that already has a position or an entry waiting, a stop or target on the wrong side. A limit is post-only (a maker or nothing). The order is kept in the journal's trades/<month>.md.",
      "steps": [
        {
          "id": "go",
          "kind": "manual",
          "x": 0,
          "y": 0,
          "values": {}
        },
        {
          "id": "check",
          "kind": "filter",
          "x": 260,
          "y": 0,
          "values": {
            "If": "has(payload.symbol) && payload.symbol in [\"BTCUSDT\", \"ETHUSDT\", \"BNBUSDT\", \"BCHUSDT\"] && has(payload.side) && has(payload.type) && has(payload.quantity) && has(payload.stop_loss) && has(payload.approaches) && has(payload.reason) && payload.reason != \"\""
          }
        },
        {
          "id": "bad",
          "kind": "fail",
          "x": 520,
          "y": 160,
          "values": {
            "Message": "open needs a JSON object with symbol (BTCUSDT, ETHUSDT, BNBUSDT, BCHUSDT), side, type, quantity, stop_loss, approaches and reason (and price for a limit)"
          }
        },
        {
          "id": "order",
          "kind": "binance-order",
          "x": 520,
          "y": 0,
          "values": {
            "Connection": "b1",
            "Type": "Market",
            "Side": "Buy",
            "Time In Force": "Post Only",
            "Reduce Only": "No",
            "Require Stop": "Yes",
            "Max Notional": "1000",
            "Max Loss": "100",
            "Testnet Only": "Yes",
            "One Per Symbol": "Yes",
            "Max Leverage": "5",
            "Limit Expiry": "15"
          }
        },
        {
          "id": "entry",
          "kind": "template",
          "x": 780,
          "y": 160,
          "values": {
            "Text": "{{payload.symbol}}\n{{payload.approaches}}\nopen {{payload.side}} {{payload.type}} {{payload.quantity}} at {{has(payload.price) ? payload.price : \"market\"}}, stop loss {{payload.stop_loss}}, take profit {{has(payload.take_profit) ? payload.take_profit : \"none\"}}; approaches {{payload.approaches}}\n{{payload.reason}}"
          }
        },
        {
          "id": "keep",
          "kind": "bash",
          "x": 780,
          "y": 0,
          "values": {
            "Storage": "s1",
            "Timeout": "1m",
            "Non-zero Exit": "Fails",
            "Script": "set -eu\nexport LC_ALL=C\n# Line 1 the symbol, line 2 the approaches (a,b), the rest the entry.\nIFS= read -r symbol\nIFS= read -r approaches || true\nbody=$(cat)\n[[ $symbol =~ ^[A-Z0-9]{3,30}$ ]] || { echo \"not a symbol: $symbol\" >&2; exit 1; }\nnow=$(date -u '+%Y-%m-%d %H:%M UTC')\nmonth=$(date -u +%Y-%m)\nmkdir -p trades approaches\nf=\"trades/$month.md\"\n[ -f \"$f\" ] || printf '# Trades %s\\n' \"$month\" > \"$f\"\nprintf '\\n## %s %s\\n\\n%s\\n' \"$now\" \"$symbol\" \"$body\" >> \"$f\"\nfirst=$(printf '%s\\n' \"$body\" | head -n 1)\nfor a in $(printf '%s' \"$approaches\" | tr -d '[]\" ' | tr ',' ' '); do\n  [[ $a =~ ^[a-z0-9_]{2,40}$ ]] || { echo \"skipped the approach name $a\" >&2; continue; }\n  p=\"approaches/$a.md\"\n  [ -f \"$p\" ] || printf '# %s (`%s`)\\n\\nNot described yet: describe it with the approach workflow.\\n\\n## Trades and lessons\\n\\n' \"$a\" \"$a\" > \"$p\"\n  printf -- '- %s %s: %s ([trades/%s.md](../trades/%s.md))\\n' \"$now\" \"$symbol\" \"$first\" \"$month\" \"$month\" >> \"$p\"\ndone\necho \"kept in $f\""
          }
        },
        {
          "id": "kb",
          "kind": "knowledge-base",
          "x": 1040,
          "y": 160,
          "values": {
            "Knowledge": "k1",
            "Sync": "No"
          }
        },
        {
          "id": "sync",
          "kind": "knowledge-sync",
          "x": 1040,
          "y": 0,
          "values": {}
        },
        {
          "id": "say",
          "kind": "template",
          "x": 1300,
          "y": 160,
          "values": {
            "Text": "trade {{payload.symbol}} open {{payload.side}} {{payload.type}} {{payload.quantity}} at {{has(payload.price) ? payload.price : \"market\"}}, stop loss {{payload.stop_loss}}, take profit {{has(payload.take_profit) ? payload.take_profit : \"none\"}}; approaches {{payload.approaches}}\n{{payload.reason}}"
          }
        },
        {
          "id": "tell",
          "kind": "telegram-send",
          "x": 1300,
          "y": 0,
          "values": {
            "Connection": "t1",
            "Chat": "1108826443",
            "Format": "Plain",
            "Media": "None"
          }
        }
