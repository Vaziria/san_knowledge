    {
      "name": "trade lesson",
      "description": "Writes the lesson of a closed trade into the trading journal (lessons/<month>.md, and a line in each approach's file), for the trade tick. Run with {\"id\": \"BTCUSDT-20261030-130512\" (the id the tick lists), \"symbol\": \"BTCUSDT\", \"approaches\": \"big_trend,positioning\", \"result\": \"-1.04R, -3.26 USDT\", \"lesson\": \"What happened: ... Why: ... Lesson: ...\"}. A trade gets one lesson.",
      "steps": [
        {
          "id": "go",
          "kind": "manual",
          "x": 0,
          "y": 0,
          "values": {}
        },
        {
          "id": "check",
          "kind": "filter",
          "x": 260,
          "y": 0,
          "values": {
            "If": "has(payload.id) && has(payload.symbol) && has(payload.approaches) && has(payload.result) && has(payload.lesson) && payload.lesson != \"\""
          }
        },
        {
          "id": "bad",
          "kind": "fail",
          "x": 520,
          "y": 160,
          "values": {
            "Message": "lesson needs {\"id\", \"symbol\", \"approaches\", \"result\", \"lesson\"}"
          }
        },
        {
          "id": "entry",
          "kind": "template",
          "x": 260,
          "y": 160,
          "values": {
            "Text": "{{payload.id}}\n{{payload.symbol}}\n{{payload.approaches}}\n{{payload.result}}\n{{payload.lesson}}"
          }
        },
        {
          "id": "keep",
          "kind": "bash",
          "x": 520,
          "y": 0,
          "values": {
            "Storage": "s1",
            "Timeout": "1m",
            "Non-zero Exit": "Fails",
            "Script": "set -eu\nexport LC_ALL=C\n# Lines: the trade's id, symbol, approaches (a,b), result; the rest the lesson.\nIFS= read -r id\nIFS= read -r symbol\nIFS= read -r approaches\nIFS= read -r result\nbody=$(cat)\n[[ $id =~ ^[A-Z0-9]{3,30}-[0-9]{8}-[0-9]{6}$ ]] || { echo \"not a trade id: $id (give the id listed, such as BTCUSDT-20261030-130512)\" >&2; exit 1; }\n[ -n \"$body\" ] || { echo \"the lesson is empty\" >&2; exit 1; }\nmkdir -p lessons approaches\nif grep -qx \"$id\" lessons/done.txt 2>/dev/null; then echo \"$id already has a lesson\" >&2; exit 1; fi\nmonth=$(date -u +%Y-%m)\nf=\"lessons/$month.md\"\n[ -f \"$f\" ] || printf '# Lessons %s\\n' \"$month\" > \"$f\"\nprintf '\\n## %s\\n\\n%s %s. %s\\n' \"$id\" \"$symbol\" \"$result\" \"$body\" >> \"$f\"\nprintf '%s\\n' \"$id\" >> lessons/done.txt\nfor a in $(printf '%s' \"$approaches\" | tr -d '[]\" ' | tr ',' ' '); do\n  [[ $a =~ ^[a-z0-9_]{2,40}$ ]] || continue\n  p=\"approaches/$a.md\"\n  [ -f \"$p\" ] || printf '# %s (`%s`)\\n\\nNot described yet: describe it with the approach workflow.\\n\\n## Trades and lessons\\n\\n' \"$a\" \"$a\" > \"$p\"\n  printf -- '- %s: %s. Its lesson: [lessons/%s.md](../lessons/%s.md), %s.\\n' \"$id\" \"$result\" \"$month\" \"$month\" \"$id\" >> \"$p\"\ndone\necho \"the lesson of $id is in $f\""
          }
        },
        {
          "id": "kb",
          "kind": "knowledge-base",
          "x": 780,
          "y": 160,
          "values": {
            "Knowledge": "k1",
            "Sync": "No"
