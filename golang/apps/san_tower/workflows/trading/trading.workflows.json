            "Script": "set -eu\nexport LC_ALL=C\n# Line 1 the name, line 2 the title, the rest the description.\nIFS= read -r name\nIFS= read -r title\ndesc=$(cat)\n[[ $name =~ ^[a-z0-9_]{2,40}$ ]] || { echo \"a name is lowercase letters, digits and _ (big_trend), not $name\" >&2; exit 1; }\n[ -n \"$desc\" ] || { echo \"the description is empty\" >&2; exit 1; }\nmkdir -p approaches\np=\"approaches/$name.md\"\nrest=\"\"\n[ -f \"$p\" ] && rest=$(awk 'f || /^## /{f=1; print}' \"$p\")\n[ -n \"$rest\" ] || rest=$(printf '## Trades and lessons\\n')\n{ printf '# %s (`%s`)\\n\\n%s\\n\\n' \"$title\" \"$name\" \"$desc\"; printf '%s\\n' \"$rest\"; } > \"$p.tmp\"\nmv \"$p.tmp\" \"$p\"\necho \"described in $p\""
          }
        },
