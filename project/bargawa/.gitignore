# Built by the scripts (rebuild with scripts\run.ps1); never edited by hand
*.blend
*.blend1
# Downloaded Poly Haven files (CC0): fetched again by script from the manifest
blender/assets/polyhaven/
renders/
_logs/
_work/
__pycache__/
# Godot: the editor is downloaded into tools/godot (README), its cache is rebuilt, and the place's game copy is exported
# by scripts\run.ps1 game <place>
tools/
game/.godot/
game/assets/export/
